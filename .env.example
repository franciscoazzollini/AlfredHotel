# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID to receive build notifications (send /start to your bot to discover it)
TELEGRAM_CHAT_ID=

# Secret required to call POST /api/telegram/notify (generate a random string)
TELEGRAM_NOTIFY_SECRET=change-me-to-a-long-random-string

# Public site URL used when registering the Telegram webhook
NEXT_PUBLIC_APP_URL=http://localhost:43123
